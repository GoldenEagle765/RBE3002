<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="big-field">

    <!-- model position in the world -->
    <pose>0 0 0 0 0 0</pose>

    <!-- locked postiton? -->
    <static>true</static>

    <link name="link">
      <!--pose of link relative to model-->
      <pose>0 0 0 0 0 0</pose>

      <!-- visual model-->
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://big-field/meshes/big-field-3002.stl</uri>
          </mesh>
        </geometry>
          <material>
              <ambient>0.639, 0.639, 0.616, 1.0</ambient>
              <diffuse>0.639, 0.639, 0.616, 1.0</diffuse>
              <specular>0.1 0.1 0.1 1.0</specular> 
              <emissive>0 0 0 1</emissive>
          </material>
      </visual>

      <!-- collision geometry-->
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://big-field/meshes/big-field-3002.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <inertial>
        <mass>1</mass>
        <inertia>
          <ixx>0.0002</ixx>
          <iyy>0.0002</iyy>
          <izz>0.0002</izz>
        </inertia>
      </inertial>

    </link>
  </model>
</sdf>